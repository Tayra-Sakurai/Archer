<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archer"
    xmlns:local2="using:Archer.TemplatedElements">

    <Style TargetType="local2:RemoveActionButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <AppBarButton
                        Icon="Delete"
                        x:Uid="RemoveBtn"
                        AccessKey="{TemplateBinding AccessKey}"
                        AllowDrop="{TemplateBinding AllowDrop}"
                        AllowFocusOnInteraction="{TemplateBinding AllowFocusOnInteraction}"
                        AllowFocusWhenDisabled="{TemplateBinding AllowFocusWhenDisabled}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Command="{x:Null}"
                        CommandParameter="{x:Null}">
                        <AppBarButton.Flyout>
                            <Flyout>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="RemoveCheckMessage"
                                        Style="{StaticResource BaseTextBlockStyle}"/>
                                    <Button
                                        x:Uid="RemoveConfirmBtn"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{TemplateBinding Command}"
                                        CommandParameter="{TemplateBinding CommandParameter}"/>
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:DataCommandBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:DataCommandBar">
                    <CommandBar
                        DefaultLabelPosition="Right">
                        <AppBarButton
                            Icon="Save"
                            x:Uid="SaveBtn"
                            Command="{TemplateBinding SaveCommand}"/>
                        <local2:RemoveActionButton
                            Command="{TemplateBinding RemoveCommand}"/>
                    </CommandBar>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:DataViewCommands">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:DataViewCommands">
                    <CommandBar
                        DefaultLabelPosition="Right">
                        <AppBarButton
                            Icon="Sync"
                            x:Uid="LoadBtn"
                            Command="{TemplateBinding LoadCommand}"/>
                        <AppBarButton
                            Icon="Add"
                            x:Uid="AddBtn"
                            Command="{TemplateBinding AddCommand}"/>
                        <AppBarButton
                            Icon="More"
                            x:Uid="DetailBtn"
                            Command="{TemplateBinding DetailCommand}"
                            CommandParameter="{TemplateBinding DetailCommandParameter}"/>
                        <local2:RemoveActionButton
                            Command="{TemplateBinding RemoveCommand}"
                            CommandParameter="{TemplateBinding RemoveCommandParameter}"/>
                        <AppBarButton
                            Icon="Zoom"
                            x:Uid="SearchBtn"
                            Command="{TemplateBinding SearchCommand}"
                            CommandParameter="{TemplateBinding SearchCommandParameter}"/>
                    </CommandBar>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:ValidationTextBox" xmlns:local2="using:Archer.TemplatedElements">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:ValidationTextBox">
                    <StackPanel>
                        <TextBox
                            Text="{TemplateBinding Text}"
                            Header="{TemplateBinding Header}"
                            Name="Box"/>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemErrorTextColor}"
                            Name="Message"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:ValidationNumberBox" xmlns:local2="using:Archer.TemplatedElements">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:ValidationNumberBox">
                    <StackPanel>
                        <NumberBox
                            Header="{TemplateBinding Header}"
                            Value="{TemplateBinding Value}"
                            Name="Box"/>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                            Name="Block"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
