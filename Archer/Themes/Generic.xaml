<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archer"
    xmlns:local2="using:Archer.TemplatedElements">

    <Style TargetType="local2:RemoveActionButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <AppBarButton
                        Icon="Delete"
                        x:Uid="RemoveBtn"
                        AccessKey="{TemplateBinding AccessKey}"
                        AllowDrop="{TemplateBinding AllowDrop}"
                        AllowFocusOnInteraction="{TemplateBinding AllowFocusOnInteraction}"
                        AllowFocusWhenDisabled="{TemplateBinding AllowFocusWhenDisabled}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Command="{x:Null}"
                        CommandParameter="{x:Null}">
                        <AppBarButton.Flyout>
                            <Flyout>
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="RemoveCheckMessage"
                                        Style="{StaticResource BaseTextBlockStyle}"/>
                                    <Button
                                        x:Uid="RemoveConfirmBtn"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{TemplateBinding Command}"
                                        CommandParameter="{TemplateBinding CommandParameter}"/>
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:DataCommandBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:DataCommandBar">
                    <CommandBar
                        DefaultLabelPosition="Right">
                        <AppBarButton
                            Icon="Save"
                            x:Uid="SaveBtn"
                            Command="{TemplateBinding SaveCommand}"/>
                        <local2:RemoveActionButton
                            Command="{TemplateBinding RemoveCommand}"/>
                    </CommandBar>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
