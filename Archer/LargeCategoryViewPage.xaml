<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Archer.LargeCategoryViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local2="using:Archer.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            VerticalAlignment="Top"
            x:Uid="LargeCategoryEditDesc"/>
        <local2:ValidationTextBox
            Grid.Row="1"
            x:Uid="NameEdit"
            PropertyName="Name"
            DataErrorInfo="{x:Bind viewModel}"
            Text="{x:Bind viewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <local2:DataCommandBar
            Grid.Row="2"
            SaveCommand="{x:Bind viewModel.SaveCommand}"
            RemoveCommand="{x:Bind viewModel.RemoveCommand}"/>
    </Grid>
</Page>
