<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Archer.MediumCategoriesViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    xmlns:local2="using:Archer.TemplatedElements"
    xmlns:models="using:Caesar.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            x:Uid="MediumCategoriesViewDesc"/>
        
        <tv:TableView
            ItemsSource="{x:Bind viewModel.MediumCategories}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            d:DataContext="{d:DesignInstance Type=models:MediumCategory}"
            x:Name="Table"
            Grid.Row="1">
            <tv:TableView.Columns>
                <tv:TableViewNumberColumn x:Uid="IdColumn" Binding="{Binding Id}"/>
                <tv:TableViewTextColumn x:Uid="LargeCategoryColumn" Binding="{Binding LargeCategory.Name}"/>
                <tv:TableViewTextColumn x:Uid="NameColumn" Binding="{Binding Name}" Width="*"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <TextBox
            Grid.Row="2"
            x:Name="SearchBox"
            x:Uid="SearchBox"/>

        <local2:DataViewCommands
            Grid.Row="3"
            AddCommand="{x:Bind viewModel.AddCommand}"
            LoadCommand="{x:Bind viewModel.LoadCommand}"
            RemoveCommand="{x:Bind viewModel.RemoveCommand}"
            RemoveCommandParameter="{Binding SelectedItem, ElementName=Table}"
            DetailCommand="{x:Bind viewModel.DetailCommand}"
            DetailCommandParameter="{Binding SelectedItem, ElementName=Table}"
            SearchCommand="{x:Bind viewModel.SearchCommand}"
            SearchCommandParameter="{Binding Text, ElementName=SearchBox}"/>
    </Grid>
</Page>
