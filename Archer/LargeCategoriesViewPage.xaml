<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Archer.LargeCategoriesViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Archer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Caesar.Models"
    xmlns:tv="using:WinUI.TableView"
    xmlns:tc="using:Archer.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock
            Style="{StaticResource BodyTextBlockStyle}"
            x:Uid="LargeCategoriesViewDesc"/>
        <tv:TableView
            Grid.Row="1"
            SelectionMode="Single"
            SelectionUnit="Row"
            AutoGenerateColumns="False"
            ItemsSource="{x:Bind viewModel.LargeCategories, Mode=OneWay}"
            d:DataContext="{d:DesignInstance Type=models:LargeCategory}"
            IsReadOnly="True"
            x:Name="Table">
            <tv:TableView.Columns>
                <tv:TableViewNumberColumn Binding="{Binding Id}" x:Uid="IdColumn"/>
                <tv:TableViewTextColumn Binding="{Binding Name}" x:Uid="NameColumn" Width="*"/>
            </tv:TableView.Columns>
        </tv:TableView>
        <TextBox
            Grid.Row="2"
            x:Name="SearchBox"
            x:Uid="SearchBox"/>
        <tc:DataViewCommands
            Grid.Row="3"
            AddCommand="{x:Bind viewModel.AddCommand}"
            LoadCommand="{x:Bind viewModel.LoadCommand}"
            RemoveCommand="{x:Bind viewModel.RemoveCommand}"
            RemoveCommandParameter="{Binding SelectedItem, ElementName=Table}"
            DetailCommand="{x:Bind viewModel.InvokeCommand}"
            DetailCommandParameter="{Binding SelectedItem, ElementName=Table}"
            SearchCommand="{x:Bind viewModel.SearchCommand}"
            SearchCommandParameter="{Binding Text, ElementName=SearchBox}"/>
    </Grid>
</Page>
